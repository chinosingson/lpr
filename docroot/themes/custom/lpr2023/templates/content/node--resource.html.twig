{% set ratio_type = node.field_presentation_aspect_ratio.value == "embed-responsive-4by3" ? "ratio-4x3" : "ratio-16x9" %}
{% set resource_type = content.field_resource_type.0 %}
{% set publish_date = content.field_publish_date.0 %}
<div class="container header-spacer">
<div class="row">

    <div class="col-lg-8">
        
         <h1>{{ label }}</h1>
    <div class="metadata-top">{% if resource_type is not null %} {{ resource_type }} | {% endif %}{{ publish_date is not null ? publish_date['#markup'] : "" }}
    </div> 
    <div>{{ drupal_block("social_sharing_buttons_block") }}</div>
        {% if node.field_image.value %}
        
        <div class="resource-cover">
        <a href="{{ file_url(node.field_files.entity.uri.value) }}{{ node.field_resource_link.uri }}" target="_blank"><img class="img-fluid cover-image" src="{{ file_url(content.field_image|field_target_entity.uri.value) }}" alt="{{ content.field_image|field_raw('alt') }}"></a> 
        </div>
        {% endif %}
    
        
        {% if node.field_presentation_file.value %}
        
        <div id="presentation-window" class="presentation-window border border-secondary border-2 mb-3 ratio {{ resource_type['#title'] == "Presentations" ? "presentations" : ""}} {{ ratio_type }}">
            {{ content.field_presentation_file }}
        </div>    
        
        {% endif %}
        
        {% if content.body %}
        {{ content.body }}
        {% endif %}
        
        

      
            
     
        
      
    </div>
    
    <div class="col-lg-4">
        {% if node.field_presentation_file.value %}
        
        {% set file_name = node.field_presentation_file.entity.getFilename() %}
        {% set file_label = file_name|split('.')|slice(1, length-1)|join('.') %}
        {% set file_size = node.field_presentation_file.entity.getSize() %}
        {% set file_extension = file_name|split('.')|last %}

        <a class="resource-button btn btn-primary mb-3 p-2 w-100 d-flex" href="{{ file_url(node.field_presentation_file.entity.uri.value) }}" target="_blank">
         <span class="resource-dl flex-grow-1 text-start align-content-center">Download File</span><br />
         <span class="file-metadata flex-shrink-1 fw-light align-content-center">
            {# {% if file_name %} {{ file_name }}<br/>{% endif %} #}
            {{ file_extension }} | {{ node.field_presentation_file.entity.filesize.value | format_bytes }}
         </span>
        </a>
        
        {% endif %}
        
        
        
        {% if node.field_files.value %}
         {% set files = node.field_files  %}
         {% for file in files %}
            {% set file_name = file.entity.getFilename() %}
            {# {% set file_label = file_name|split('.')|slice(1, length-1)|join('.') %} #}
            {% set file_size = file.entity.getSize() %}
            {% set file_description = file.description %}
            {% set file_extension = file_name|split('.')|last %}
            
            <a class="resource-button btn btn-primary mb-3 p-2 w-100 d-flex" href="{{ file_url(file.entity.uri.value) }}" target="_blank">
               <span class="resource-dl flex-grow-1 text-start align-content-center">Download File {% if file.description %} ({{ file.description }}){% endif %}</span>
               <span class="flex-shrink-1 file-metadata fw-light align-content-center">
               {{ file_extension }} | {{ file_size | format_bytes }}
               </span>
            </a>
         {% endfor %}
        {% endif %}
        
        
        {% if node.field_resource_link.value %}
        
        <a class="resource-button btn btn-primary mb-3 p-2 w-100" href="{{ node.field_resource_link.uri }}" target="_blank">
        {# <i class="fas fa-external-link-alt document-download-button"></i>&nbsp;&nbsp; #}
        {{ node.field_resource_link.title }}<br /><span class="file-metadata">Browse website</span></span></a>
        {% endif %}
        
        {% if node.field_related_content.value %}
        
           <div class="related-links">
           <h3>Related Links</h3>
              <ul class="related-links-set">
                  {{ content.field_related_content }}
              </ul>    
           </div>  
        <hr />   
        {% endif %}
    
        
        {% if node.field_series.value %}
        
           <div class="related-links">
           <h3>Series</h3>
              <ul class="related-links-set">
                  {{ content.field_series }}
              </ul>    
           </div>    
        <hr />
        {% endif %}
        
        {% if node.field_organization.value %}
        
           <div class="related-links">
           <h3>Organizations</h3>
              <ul class="related-links-set">
                  {{ content.field_organization }}
              </ul>    
           </div>    
        <hr />
        {% endif %}
        
        {% if node.field_focus_areas.value %}
        
           <div class="related-links">
           <h3>Focus Areas</h3>
              <ul class="related-links-set">
                  {{ content.field_focus_areas }}
              </ul>    
           </div>   
        <hr />   
        {% endif %}
        
        {% if node.field_subjects.value %}
        
           <div class="related-links">
           <h3>Subjects</h3>
              <ul class="related-links-set">
                  {{ content.field_subjects }}
              </ul>    
           </div>   
        <hr />   
        {% endif %}
        
        
        {% if node.field_topics.value %}
        
           <div class="related-links">
           <h3>Topics</h3>
              <ul class="related-links-set">
                  {{ content.field_topics }}
              </ul>    
           </div>   
        <hr />   
        {% endif %}
        
        {% if node.field_sub_regions.value %}
        
           <div class="related-links">
           <h3>Sub-regions</h3>
              <ul class="related-links-set">
                  {{ content.field_sub_regions }}
              </ul>    
           </div>    
        <hr />
        {% endif %}        

        {% if node.field_countries.value %}
        
           <div class="related-links">
           <h3>Countries</h3>
              <ul class="related-links-set">
                  {{ content.field_countries }}
              </ul>    
           </div>    
        <hr />
        {% endif %}

        {% if node.field_authors.value %}
           <div class="related-links">
           <h3>Authors</h3>
              <ul class="related-links-set">
              {{ content.field_authors }}
              </ul>    
           </div>    
        <hr />
        {% endif %}

            
    </div>




</div>
</div>

<div class="clearfix">&nbsp;</div>
<div class="clearfix">&nbsp;</div>